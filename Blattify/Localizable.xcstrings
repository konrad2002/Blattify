    "^[%lld entry](inflect: true) and ^[%lld pest record](inflect: true) will be deleted as well. Cuttings are kept. The code %@ will not be used again." : {
      "comment" : "A message that warns the user that all data associated with a plant will be deleted, including its entries, pest records, and even the plant code.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld Eintrag](inflect: true) und ^[%lld Schädlingseintrag](inflect: true) werden ebenfalls gelöscht. Ableger bleiben erhalten. Der Code %@ wird nicht erneut vergeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "^[%1$lld entry](inflect: true) and ^[%2$lld pest record](inflect: true) will be deleted as well. Cuttings are kept. The code %3$@ will not be used again."
          }
        }
      }
    },
    "^[%lld photo](inflect: true)" : {
